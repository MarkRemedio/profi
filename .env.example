# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret — service-role key. Never expose with NEXT_PUBLIC_.
# Used by scripts/grant-admin.cjs to set the platform_admin claim.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin impersonation — server-only secret used to sign the impersonation pass cookie.
# Generate with: openssl rand -base64 32
IMPERSONATION_SECRET=your-impersonation-secret

# Database (Prisma)
DATABASE_URL=postgresql://user:pass@host:5432/db
DIRECT_URL=postgresql://user:pass@host:5432/db

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx

# Mistral — PDF bank statement scanning (OCR + layout analysis).
# Without this, PDF statement import fails with "Scanning unavailable".
# CSV import is unaffected.
MISTRAL_API_KEY=
# Optional model overrides; sensible defaults are built in.
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_ANALYSIS_MODEL=mistral-small-latest
# MISTRAL_EXTRACTION_MODEL=mistral-small-latest

# OpenAI — read-only workspace AI Assistant.
# Keep the key server-only; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_AI_ASSISTANT_MODEL=gpt-5.6-terra

# Any random string. Set the same value in Vercel's project env vars — Vercel
# Cron then sends it as `Authorization: Bearer $CRON_SECRET` automatically on
# every scheduled invocation (see vercel.json), which
# app/api/cron/cleanup-statements/route.ts checks before doing anything.
# Not needed for local dev; cron only fires from Vercel's infrastructure.
CRON_SECRET=

# ── HMRC Making Tax Digital ──────────────────────────────────────────────────
# The same developer-hub application as the VAT number lookup, but it must also
# be subscribed to the "VAT (MTD)" API, and the redirect URI below must be
# registered on the application exactly as sent:
#   {NEXT_PUBLIC_BASE_URL}/api/hmrc/callback
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Sandbox while testing, https://api.service.hmrc.gov.uk in production.
HMRC_API_BASE=https://test-api.service.hmrc.gov.uk
# Any long random string. Seals HMRC refresh tokens before they are written to
# the database — a refresh token can file VAT returns for a real business for
# 18 months, so connecting is refused outright when this is unset.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it makes every existing connection unreadable and they must reconnect.
HMRC_TOKEN_KEY=

# ── TrueLayer Open Banking bank feeds ───────────────────────────────────────
# Create a Data API app in TrueLayer Console. Its redirect URI must exactly be:
#   {NEXT_PUBLIC_BASE_URL}/api/banking/truelayer/callback
# Start in sandbox. `TRUELAYER_ENVIRONMENT=production` switches to the live
# TrueLayer hosts after the app is approved. Do not expose these values with a
# NEXT_PUBLIC_ prefix.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_ENVIRONMENT=sandbox
# Sandbox uses TrueLayer's Mock Bank. In production the app defaults to
# uk-ob-all; set this only when you need to restrict the provider list.
# TRUELAYER_PROVIDERS=uk-cs-mock
# Optional overrides for a non-standard TrueLayer environment.
# TRUELAYER_API_BASE=
# TRUELAYER_AUTH_BASE=
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing TRUELAYER_TOKEN_KEY makes saved bank connections unreadable, so users
# must reconnect any feeds created with the old key.
TRUELAYER_TOKEN_KEY=
TRUELAYER_STATE_SECRET=
